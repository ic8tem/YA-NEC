CM YA-NEC FORMATO=yanec 2
CM YANEC NOME=LPDA by Tau+Sigma
CM YANEC DESCRIZIONE=LPDA by Tau+Sigma
CM YANEC CATEGORIA=AutoEZ (esempi AC6LA)
CM YANEC FONTE=AutoEZ di Dan Maguire AC6LA (esempi) e modelli forniti da IC8TEM
CM YANEC ORIGINALE=LPDA by Tau+Sigma.weq
CM YANEC CONTENUTO=weq
MultiNEC	14	in	in	SLT30	*** DO NOT MAKE MANUAL EDITS TO THIS FILE ***

_13.6	_Min Freq	"_<<< Variables B thru M, user input, set as desired."			
_30	_Max Freq	"_=""          Design bandwidth will be  (Fmin * "" & FIXED(0.93, 2) & "")  to  (Fmax * "" & FIXED(1.3, 1) & "")"""			
_0.85	"_=""Tau  ("" & FIXED(0.8, 2) & "" to "" & FIXED(0.98, 2) & "")"" & IF(S > 70, ""     >>> Max 70 elements, reduce Tau or reduce Bandwidth <<<"", """")"				
_0.04	"_=""Sigma  ("" & FIXED(0.03, 2) & "" to "" & FIXED(0.243 * E - 0.051, 2, TRUE) & "", optimum = "" & FIXED(0.243 * E - 0.051, 2, TRUE) & "")"""				
_0.5	"_=""Rear element diameter ("" & UnitsDia & "")"""				
_0	"_Constant diameters?  0=No, 1=Yes"		"_Calculator for Feeder Zo.  Enter desired input Z in cell E20,"		
_6	"_=""Rear stub length ("" & UnitsXYZ & "")  0=no stub"""		_read approximate required Feeder Zo in cell E21.		
_600	_Rear stub Zo	_200	_Desired input (feedpoint) Z		
_412	_Feeder (phase-line) Zo	"_=ROUND(E20^2 / (8 * G / SQRT(E) * 120 * (LN(U) - 2.25)) + E20 * SQRT((E20 / (8 * G / SQRT(E) * 120 * (LN(U) - 2.25))^2) + 1), 0)"	_Feeder (phase-line) Zo		
_850	"_=""Boom height ("" & UnitsXYZ & "")"""				


_=299.792458 / UnitsFact / (B * 0.93) * 0.94901369239916 * 0.5	"_=""Length rear element"" & IF(UnitsXYZ=""in"", ""  ("" & FIXED(P/12, 2, TRUE) & "" ft)"", """")"	"_<<< Variables P thru V, calculated values, do not modify."			
_=G * 2 * P	"_=""Initial spacing"" & IF(UnitsXYZ=""in"", ""  ("" & FIXED(Q/12, 2, TRUE) & "" ft)"", """")"				
_=INT(LOG((B * 0.93) / (D * 1.3)) / LOG(E) + 1)	_Number of elements  (max 70)		"_Calculator for Feeder spacing.  Enter Feeder Zo in cell E29,"					
_=Q * (1 + E * (1 - E^(S-2)) / (1 - E))	"_=""Boom length"" & IF(UnitsXYZ=""in"", ""  ("" & FIXED(T/12, 2, TRUE) & "" ft)"", """")"		"_enter wire diameter in cell E30, read spacing in cell E31."					
"_=P / IF(UnitsXYZ=""ft"", H/12, IF(UnitsXYZ=""m"", H/1000, H))"	_L/D (Length/Diameter) ratio	_412	_Feeder (phase-line) Zo					
"_=ROUND(DEGREES(ATAN((1-E) / (4*G))), 1)"	_Alpha angle (deg)	_0.0808	"_Wire diameter, inches or mm"					
		"_=ROUND(E30 * COSH(E29 / 120 / 0.95), 4)"	"_=""Wire spacing, same units  (assumes VF="" & FIXED(0.95, 2) & "")"""					


	_LPDA by Tau+Sigma							
