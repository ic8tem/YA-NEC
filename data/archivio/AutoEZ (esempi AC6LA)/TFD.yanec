_m	_=$B$15	"_=ROUND($C$15 * COS(RADIANS(-N)) - $D$15 * SIN(RADIANS(-N)), 9)"	"_=ROUND($C$15 * SIN(RADIANS(-N)) + $D$15 * COS(RADIANS(-N)), 9)"	_=$E$15	"_=ROUND($F$15 * COS(RADIANS(-N)) - $G$15 * SIN(RADIANS(-N)), 9)"	"_=ROUND($F$15 * SIN(RADIANS(-N)) + $G$15 * COS(RADIANS(-N)), 9)"	_#14	_=ODD(WireLen / 32.786 * 25)																								
_m	_=$B$16	"_=ROUND($C$16 * COS(RADIANS(-N)) - $D$16 * SIN(RADIANS(-N)), 9)"	"_=ROUND($C$16 * SIN(RADIANS(-N)) + $D$16 * COS(RADIANS(-N)), 9)"	_=$E$16	"_=ROUND($F$16 * COS(RADIANS(-N)) - $G$16 * SIN(RADIANS(-N)), 9)"	"_=ROUND($F$16 * SIN(RADIANS(-N)) + $G$16 * COS(RADIANS(-N)), 9)"	_#14	"_=CEILING(WireLen / 32.786 * 50, 1)"																								
