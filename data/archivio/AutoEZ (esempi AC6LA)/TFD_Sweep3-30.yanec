CM YA-NEC FORMATO=yanec 2
CM YANEC NOME=TFD_Sweep3-30
CM YANEC DESCRIZIONE=TFD_Sweep3-30
CM YANEC CATEGORIA=AutoEZ (esempi AC6LA)
CM YANEC FONTE=AutoEZ di Dan Maguire AC6LA (esempi) e modelli forniti da IC8TEM
CM YANEC ORIGINALE=TFD_Sweep3-30.weq
CM YANEC CONTENUTO=weq
MultiNEC	3	ft	in	SLT30	*** DO NOT MAKE MANUAL EDITS TO THIS FILE ***

_1000	"_Applied (input) power, watts"				
_#N/A	"_Load power, watts (calculated)"	_LoadPower = LoadAmps^2 * LoadR and			
	"_   Note that ""D"" and ""J"" are"	_with a 1A source SrcPower = 1A^2 * SrcR = SrcR.			
	"_   *calculated*, not set directly."	"_So load power at ""B"" watts input = LoadAmps^2 * LoadR * (B / SrcR)."			
	_   See Calculate sheet for values.	_(Also see note below on row 29.)			
	_   Will always show here as #N/A.				
_#N/A	"_Load loss, dB (calculated)"	_ =-10 * LOG10(1 - (LoadPower / InputPower))			
		"_Formulas to set ""D"" and ""J"" are on the Calculate sheet."			
_89.24	"_Wire length, feet"				
_7.8	"_Wire spacing, inches"				
_15	"_Tilt angle, deg, down from horizontal"				
_50	"_Height, feet, top wire (top end if tilted)"				

_820	"_Load (terminating) resistor, ohms"				
_16	_Transformer Port 2 Rel Z (Ratio 1:S)							

		_Note:  As an alternative you could set the input power level via						
		_EZNEC Options > Power Level and then *NOT* apply correction						
		"_factor ""(B / SrcR)"" to the calculated load power since EZNEC will"						
		_have adjusted the reported LoadAmps already.						

	_Terminated Folded Dipole		_(original per W4RNL)					
	"_Wires are in over/under configuration, can be rotated down by any angle and elevated to any height."							
	"_Top and bottom wires are ""L"" feet long, spacing between wires is ""M"" inches converted to feet."							
	"_Start with wires oriented horizontally, top wire (#2, row 15) at Z=0."							
_rx	_0	_0	_=-M/12	_0	_=L	_=-M/12	_#14	_=ODD(WireLen / 32.786 * 25)
_rx	_0	_0	_0	_0	_=L	_0	_#14	_=ODD(WireLen / 32.786 * 25)
_rx	_0	_0	_0	_0	_0	_=-M/12	_#14	"_=CEILING(WireLen / 32.786 * 50, 1)"
_rx	_0	_=L	_0	_0	_=L	_=-M/12	_#14	"_=CEILING(WireLen / 32.786 * 50, 1)"
	"_Rotate outside end down by ""N"" degrees."							
_m	_=$B$14	"_=ROUND($C$14 * COS(RADIANS(-N)) - $D$14 * SIN(RADIANS(-N)), 9)"	"_=ROUND($C$14 * SIN(RADIANS(-N)) + $D$14 * COS(RADIANS(-N)), 9)"	_=$E$14	"_=ROUND($F$14 * COS(RADIANS(-N)) - $G$14 * SIN(RADIANS(-N)), 9)"	"_=ROUND($F$14 * SIN(RADIANS(-N)) + $G$14 * COS(RADIANS(-N)), 9)"	_#14	_=ODD(WireLen / 32.786 * 25)																								
_m	_=$B$15	"_=ROUND($C$15 * COS(RADIANS(-N)) - $D$15 * SIN(RADIANS(-N)), 9)"	"_=ROUND($C$15 * SIN(RADIANS(-N)) + $D$15 * COS(RADIANS(-N)), 9)"	_=$E$15	"_=ROUND($F$15 * COS(RADIANS(-N)) - $G$15 * SIN(RADIANS(-N)), 9)"	"_=ROUND($F$15 * SIN(RADIANS(-N)) + $G$15 * COS(RADIANS(-N)), 9)"	_#14	_=ODD(WireLen / 32.786 * 25)																								
_m	_=$B$16	"_=ROUND($C$16 * COS(RADIANS(-N)) - $D$16 * SIN(RADIANS(-N)), 9)"	"_=ROUND($C$16 * SIN(RADIANS(-N)) + $D$16 * COS(RADIANS(-N)), 9)"	_=$E$16	"_=ROUND($F$16 * COS(RADIANS(-N)) - $G$16 * SIN(RADIANS(-N)), 9)"	"_=ROUND($F$16 * SIN(RADIANS(-N)) + $G$16 * COS(RADIANS(-N)), 9)"	_#14	"_=CEILING(WireLen / 32.786 * 50, 1)"																								
_m	_=$B$17	"_=ROUND($C$17 * COS(RADIANS(-N)) - $D$17 * SIN(RADIANS(-N)), 9)"	"_=ROUND($C$17 * SIN(RADIANS(-N)) + $D$17 * COS(RADIANS(-N)), 9)"	_=$E$17	"_=ROUND($F$17 * COS(RADIANS(-N)) - $G$17 * SIN(RADIANS(-N)), 9)"	"_=ROUND($F$17 * SIN(RADIANS(-N)) + $G$17 * COS(RADIANS(-N)), 9)"	_#14	"_=CEILING(WireLen / 32.786 * 50, 1)"																								
	"_Move all wires up by ""O"" feet."																															
	_=$B$19	_=$C$19	_=$D$19 + O	_=$E$19	_=$F$19	_=$G$19 + O	_#14	_=ODD(WireLen / 32.786 * 25)																								
	_=$B$20	_=$C$20	_=$D$20 + O	_=$E$20	_=$F$20	_=$G$20 + O	_#14	_=ODD(WireLen / 32.786 * 25)																								
	_=$B$21	_=$C$21	_=$D$21 + O	_=$E$21	_=$F$21	_=$G$21 + O	_#14	"_=CEILING(WireLen / 32.786 * 50, 1)"																								
	_=$B$22	_=$C$22	_=$D$22 + O	_=$E$22	_=$F$22	_=$G$22 + O	_#14	"_=CEILING(WireLen / 32.786 * 50, 1)"																								

	_Credit:  Initial values for variables L/M/Q/S per W4RNL																															
_V1		_1	_0	_I																						_V1		_1	_50	_1	"_=MAX(1, S)"	_N
																										"_Formula in cell H112 is ""=MAX(1, S)"" so that the value can never go below 1."						




























_2	_50	"_=MAX(0, Q)"				_Ser	_Ser
"_Formula in cell E40 is ""=MAX(0, Q)"" so that the value can never go below 0."							


























































